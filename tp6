const input = document.getElementById("inputTache");
const btnAjouter = document.getElementById("btnAjouter");
const liste = document.getElementById("listeTaches");
btnAjouter.addEventListener("click", function() {
    const texte = input.value.trim();
    if (texte === "") return;
    const li = document.createElement("li");
    li.classList.add("tache");
    li.innerHTML = `
        <span>${texte}</span>
        <div>
            <button class="btn-accomplir">✓</button>
            <button class="btn-supprimer">✖</button>
        </div>
    `;
    li.querySelector(".btn-accomplir").addEventListener("click", function() {
        li.querySelector("span").classList.toggle("accomplie");
    });
    li.querySelector(".btn-supprimer").addEventListener("click", function() {
        li.remove();
    });
    liste.appendChild(li);
    input.value = "";
});
